{
  "name": "osiriszk-base-pathfinder",
  "version": "0.6.0",
  "description": "OsirisZk Mars Base Pathfinder: where should humanity establish its first Mars research base, and why? A scientific mission-design game on the OsirisZk Earth/Mars rotorcraft simulator (Rapier, 240 Hz fixed step): drone design and budget, autonomous survey flights with photogrammetry, NASA data adapters with provenance, safety screening, TOPSIS/AHP, sensitivity analysis.",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./planet": "./src/planet/index.js",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "trace": "node tools/flighttrace.mjs",
    "check": "npm test && npm run trace",
    "dev": "vite examples/minimal --open",
    "dev:planet": "vite examples/planet --open",
    "planet:compare": "node tools/planet-compare.mjs --out reports/planet-compare",
    "bench": "node tools/physics-bench.mjs --with tools/planet-bench-scenarios.mjs --out reports/physics-bench.json",
    "dev:app": "vite app --open",
    "build": "vite build app --outDir ../dist --emptyOutDir --base ./",
    "experiments": "node tools/experiment.mjs all",
    "model-check": "node tools/model-check.mjs",
    "pathfinder": "node tools/pathfinder-run.mjs --lang both",
    "sample-rasters": "node tools/sample-rasters.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "geotiff": "^3.0.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
